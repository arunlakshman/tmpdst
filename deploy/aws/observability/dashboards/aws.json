      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Transaction cancellations and retries",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (op, reason) (rate(manicp_retries_total{run_id=\"$run_id\"}[$__rate_interval]))",
          "legendFormat": "retry {{op}} {{reason}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "refId": "A"
        },
        {
          "expr": "sum by (op) (rate(manicp_commit_attempts_total{run_id=\"$run_id\"}[$__rate_interval]))",
          "legendFormat": "attempts {{op}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "refId": "B"
        },
        {
          "expr": "sum(aws_dynamodb_transaction_conflict_sum{run_id=\"$run_id\"}) / 60",
          "legendFormat": "TransactionConflict/s (CW)",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "refId": "C"
        },
        {
          "expr": "sum(aws_dynamodb_conditional_check_failed_requests_sum{run_id=\"$run_id\"}) / 60",
          "legendFormat": "ConditionalCheckFailed/s (CW)",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "refId": "D"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
