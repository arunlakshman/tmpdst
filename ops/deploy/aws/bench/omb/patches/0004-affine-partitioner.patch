+package io.openmessaging.benchmark.driver.kafka;
+
+import java.util.Map;
+import java.util.concurrent.atomic.AtomicLong;
+import org.apache.kafka.clients.producer.Partitioner;
+import org.apache.kafka.common.Cluster;
+
+/**
+ * MDS experiment (opt-in, mdsAffine): partition-affine producers. A producer writes only the
+ * partitions p with p % mds.affine.mod == mds.affine.slot, so each broker's segments carry a disjoint
+ * partition set. Within that set it is sticky like the stock partitioner for null keys: it stays on one
+ * partition until about batch.size bytes were produced, then moves to the next. The key is ignored.
+ */
+public class MdsAffinePartitioner implements Partitioner {
+    private int mod = 1;
+    private int slot = 0;
+    private long stickBytes = 100000;
+    private final int start = java.util.concurrent.ThreadLocalRandom.current().nextInt(1 << 20);
+    private final AtomicLong sent = new AtomicLong();
+
+    @Override
+    public void configure(Map<String, ?> configs) {
+        mod = Integer.parseInt(String.valueOf(configs.get("mds.affine.mod")));
+        slot = Integer.parseInt(String.valueOf(configs.get("mds.affine.slot")));
+        Object b = configs.get("batch.size");
+        if (b != null) {
+            stickBytes = Long.parseLong(String.valueOf(b));
+        }
+    }
+
+    @Override
+    public int partition(
+            String topic, Object key, byte[] keyBytes, Object value, byte[] valueBytes, Cluster cluster) {
+        int n = cluster.partitionsForTopic(topic).size();
+        int mine = (n - slot + mod - 1) / mod; // partitions slot, slot+mod, ... below n
+        if (mine <= 0) {
+            return 0;
+        }
+        long bytes = sent.addAndGet(valueBytes == null ? 0 : valueBytes.length);
+        int idx = (int) ((bytes / stickBytes + start) % mine);
+        return slot + idx * mod;
+    }
+
+    @Override
+    public void close() {}
+}
