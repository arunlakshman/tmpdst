// Loadgen host add-on: scrape the WarpStream benchmark-producer's Prometheus
// endpoint (its -prometheus-port, default 8081). It exists only while a
// benchmark cell runs; between cells `up{job="warpstream_bench"}` is 0, which
// is expected. kafka-producer-perf-test exposes nothing: the harness captures
// its stdout summary and pushes run annotations instead.

discovery.relabel "loadgen_targets" {
	targets = [
		{"__address__" = "127.0.0.1:8081", "job" = "warpstream_bench", "service" = "loadgen"},
	]

	rule {
		target_label = "host"
		replacement  = sys.env("HOST_NAME")
	}

	rule {
		target_label = "role"
		replacement  = sys.env("HOST_ROLE")
	}
}

prometheus.scrape "loadgen" {
	targets         = discovery.relabel.loadgen_targets.output
	forward_to      = [prometheus.remote_write.cloud.receiver]
	scrape_interval = "5s"
}
