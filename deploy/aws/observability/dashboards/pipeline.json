{
  "uid": "mani-pipeline",
  "title": "Manifester - Segment pipeline",
  "tags": [
    "manifester",
    "pipeline"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "utc",
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "graphTooltip": 1,
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "PUT (seal to object stored, retries included)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le) (rate(manibroker_segment_put_seconds_bucket{run_id=\"$run_id\"}[$__rate_interval])))",
          "legendFormat": "p50",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(manibroker_segment_put_seconds_bucket{run_id=\"$run_id\"}[$__rate_interval])))",
          "legendFormat": "p99",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Queue wait (commits strictly in seal order)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le) (rate(manibroker_segment_queue_wait_seconds_bucket{run_id=\"$run_id\"}[$__rate_interval])))",
          "legendFormat": "p50",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(manibroker_segment_queue_wait_seconds_bucket{run_id=\"$run_id\"}[$__rate_interval])))",
          "legendFormat": "p99",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Commit (first CommitSegment to answer, retries included)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le) (rate(manibroker_segment_commit_seconds_bucket{run_id=\"$run_id\"}[$__rate_interval])))",
          "legendFormat": "p50",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(manibroker_segment_commit_seconds_bucket{run_id=\"$run_id\"}[$__rate_interval])))",
          "legendFormat": "p99",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Total (seal to ack)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le) (rate(manibroker_segment_seal_to_ack_seconds_bucket{run_id=\"$run_id\"}[$__rate_interval])))",
          "legendFormat": "p50",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(manibroker_segment_seal_to_ack_seconds_bucket{run_id=\"$run_id\"}[$__rate_interval])))",
          "legendFormat": "p99",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Segments in flight",
      "description": "Above 1 means PUTs overlap.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "manibroker_segments_in_flight{run_id=\"$run_id\"}",
          "legendFormat": "in flight (gauge)",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.5, sum by (le) (rate(manibroker_segments_in_flight_at_seal_bucket{run_id=\"$run_id\"}[$__rate_interval])))",
          "legendFormat": "at seal p50",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(manibroker_segments_in_flight_at_seal_bucket{run_id=\"$run_id\"}[$__rate_interval])))",
          "legendFormat": "at seal p99",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Backpressure",
      "description": "Client reads are paused while unacked produce data exceeds -max-buffered.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "rate(manibroker_reads_paused_seconds_total{run_id=\"$run_id\"}[$__rate_interval])",
          "legendFormat": "fraction of time reads paused",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "refId": "A"
        },
        {
          "expr": "manibroker_reads_paused{run_id=\"$run_id\"}",
          "legendFormat": "paused now (0/1)",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Buffered produce bytes",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "manibroker_buffered_bytes{run_id=\"$run_id\"}",
          "legendFormat": "buffered",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Control-plane call seen by broker, p50/p99 by op",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le, op) (rate(manibroker_cp_call_seconds_bucket{run_id=\"$run_id\"}[$__rate_interval])))",
          "legendFormat": "p50 {{op}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le, op) (rate(manibroker_cp_call_seconds_bucket{run_id=\"$run_id\"}[$__rate_interval])))",
          "legendFormat": "p99 {{op}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    }
  ],
  "annotations": {
    "list": [
      {
        "name": "Run start/end",
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "iconColor": "blue",
        "target": {
          "type": "tags",
          "tags": [
            "manifester",
            "run:$run_id"
          ],
          "limit": 100
        }
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "ds_prom",
        "type": "datasource",
        "query": "prometheus",
        "label": "Prometheus",
        "current": {}
      },
      {
        "name": "ds_loki",
        "type": "datasource",
        "query": "loki",
        "label": "Loki",
        "current": {}
      },
      {
        "name": "run_id",
        "type": "query",
        "label": "run_id",
        "datasource": {
          "type": "prometheus",
          "uid": "${ds_prom}"
        },
        "query": {
          "query": "label_values(up, run_id)",
          "refId": "rid"
        },
        "refresh": 2,
        "sort": 2,
        "current": {}
      }
    ]
  }
}
