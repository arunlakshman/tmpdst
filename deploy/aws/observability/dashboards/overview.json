{
  "uid": "mani-overview",
  "title": "Manifester - Overview",
  "tags": [
    "manifester",
    "overview"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "utc",
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "graphTooltip": 1,
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Aggregate throughput (all selected brokers): committed MB/s and approx msg/s",
      "description": "Write side, summed over the $broker selection. Read throughput has no broker metric yet; use the OMB consume rate.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(manibroker_segment_committed_bytes_total{run_id=\"$run_id\", broker=~\"$broker\"}[$__rate_interval]))",
          "legendFormat": "committed bytes/s",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "refId": "A"
        },
        {
          "expr": "sum(rate(manibroker_segment_sealed_batch_bytes_total{run_id=\"$run_id\", broker=~\"$broker\"}[$__rate_interval]))",
          "legendFormat": "sealed batch bytes/s",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Approx msg/s at 1 KiB per message (sealed batch bytes / 1024)",
      "description": "There is no per-record counter on the broker: this is exact only for the 1 KiB OMB workloads (batch framing makes it a slight overestimate). The OMB log/JSON is the source of truth for msg/s.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(manibroker_segment_sealed_batch_bytes_total{run_id=\"$run_id\", broker=~\"$broker\"}[$__rate_interval])) / 1024",
          "legendFormat": "msg/s (1 KiB records)",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Per-broker write throughput (committed bytes/s)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (broker) (rate(manibroker_segment_committed_bytes_total{run_id=\"$run_id\", broker=~\"$broker\"}[$__rate_interval]))",
          "legendFormat": "broker {{broker}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Skew: share of bytes per broker",
      "description": "Even split is 1/N. Clients stay on the broker they bootstrapped from, so the split follows client placement.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (broker) (rate(manibroker_segment_committed_bytes_total{run_id=\"$run_id\", broker=~\"$broker\"}[$__rate_interval])) / ignoring(broker) group_left sum(rate(manibroker_segment_committed_bytes_total{run_id=\"$run_id\", broker=~\"$broker\"}[$__rate_interval]))",
          "legendFormat": "broker {{broker}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Skew: max / min broker throughput",
      "description": "1.0 is perfectly even. Needs the brokers selected to all be taking traffic (min of 0 gives +Inf).",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "max(sum by (broker) (rate(manibroker_segment_committed_bytes_total{run_id=\"$run_id\", broker=~\"$broker\"}[$__rate_interval]))) / min(sum by (broker) (rate(manibroker_segment_committed_bytes_total{run_id=\"$run_id\", broker=~\"$broker\"}[$__rate_interval])))",
          "legendFormat": "max/min",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "refId": "A"
        },
        {
          "expr": "max(sum by (broker) (rate(manibroker_segment_committed_bytes_total{run_id=\"$run_id\", broker=~\"$broker\"}[$__rate_interval]))) / avg(sum by (broker) (rate(manibroker_segment_committed_bytes_total{run_id=\"$run_id\", broker=~\"$broker\"}[$__rate_interval])))",
          "legendFormat": "max/mean",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Open client connections per broker",
      "description": "Connections follow bootstrap choice (random among bootstrap.servers): the cause of byte skew.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "manibroker_open_connections{run_id=\"$run_id\", broker=~\"$broker\"}",
          "legendFormat": "broker {{broker}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Produce ack latency p99 per broker",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (le, broker) (rate(manibroker_segment_seal_to_ack_seconds_bucket{run_id=\"$run_id\", broker=~\"$broker\"}[$__rate_interval])))",
          "legendFormat": "p99 {{broker}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Segments per second per broker",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (broker) (rate(manibroker_segments_committed_total{run_id=\"$run_id\", broker=~\"$broker\"}[$__rate_interval]))",
          "legendFormat": "broker {{broker}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Produce ack latency (seal to commit answer)",
      "description": "put + queue wait + commit. Excludes time batches sat in the open segment buffer (see segment open age); client-observed latency comes from the load generator.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le) (rate(manibroker_segment_seal_to_ack_seconds_bucket{run_id=\"$run_id\", broker=~\"$broker\"}[$__rate_interval])))",
          "legendFormat": "p50",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(manibroker_segment_seal_to_ack_seconds_bucket{run_id=\"$run_id\", broker=~\"$broker\"}[$__rate_interval])))",
          "legendFormat": "p99",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Segment open age (first batch to seal)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le) (rate(manibroker_segment_open_age_seconds_bucket{run_id=\"$run_id\", broker=~\"$broker\"}[$__rate_interval])))",
          "legendFormat": "p50",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(manibroker_segment_open_age_seconds_bucket{run_id=\"$run_id\", broker=~\"$broker\"}[$__rate_interval])))",
          "legendFormat": "p99",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Throughput: committed segment bytes/s",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(manibroker_segment_committed_bytes_total{run_id=\"$run_id\", broker=~\"$broker\"}[$__rate_interval]))",
          "legendFormat": "committed (batch data + index)",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "refId": "A"
        },
        {
          "expr": "sum(rate(manibroker_segment_sealed_batch_bytes_total{run_id=\"$run_id\", broker=~\"$broker\"}[$__rate_interval]))",
          "legendFormat": "sealed batch bytes",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Segments per second by seal reason",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "gridPos": {
        "x": 12,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (reason) (rate(manibroker_segments_sealed_total{run_id=\"$run_id\", broker=~\"$broker\"}[$__rate_interval]))",
          "legendFormat": "{{reason}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "refId": "A"
        },
        {
          "expr": "sum(rate(manibroker_segments_failed_total{run_id=\"$run_id\", broker=~\"$broker\"}[$__rate_interval]))",
          "legendFormat": "failed",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Segment size (mean committed bytes per segment)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "gridPos": {
        "x": 0,
        "y": 48,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(manibroker_segment_committed_bytes_total{run_id=\"$run_id\", broker=~\"$broker\"}[$__rate_interval])) / sum(rate(manibroker_segments_committed_total{run_id=\"$run_id\", broker=~\"$broker\"}[$__rate_interval]))",
          "legendFormat": "mean",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Buffered produce bytes (unacked)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "gridPos": {
        "x": 12,
        "y": 48,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "manibroker_buffered_bytes{run_id=\"$run_id\", broker=~\"$broker\"}",
          "legendFormat": "buffered",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 15,
      "type": "row",
      "title": "Control plane (single manicp sequencer)",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 56,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Commit rate: groups/s and segments/s",
      "description": "One TransactWriteItems per group. Segments/s should match the sum over brokers of segments/s.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "gridPos": {
        "x": 0,
        "y": 57,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (outcome) (rate(manicp_seq_tx_seconds_count{run_id=\"$run_id\"}[$__rate_interval]))",
          "legendFormat": "groups/s {{outcome}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "refId": "A"
        },
        {
          "expr": "sum(rate(manicp_seq_group_segments_sum{run_id=\"$run_id\"}[$__rate_interval]))",
          "legendFormat": "segments/s committed",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "Queue depth and groups in flight",
      "description": "A persistently non-zero queue depth means the sequencer is the bottleneck.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "gridPos": {
        "x": 12,
        "y": 57,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "max(manicp_seq_queue_depth{run_id=\"$run_id\"})",
          "legendFormat": "queue depth",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "refId": "A"
        },
        {
          "expr": "max(manicp_seq_inflight_groups{run_id=\"$run_id\"})",
          "legendFormat": "groups in flight",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 18,
      "type": "timeseries",
      "title": "Group size (segments per transaction, p50/p99)",
      "description": "Group commit: how many broker commits ride on one DynamoDB transaction.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "gridPos": {
        "x": 0,
        "y": 65,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le) (rate(manicp_seq_group_segments_bucket{run_id=\"$run_id\"}[$__rate_interval])))",
          "legendFormat": "p50",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(manicp_seq_group_segments_bucket{run_id=\"$run_id\"}[$__rate_interval])))",
          "legendFormat": "p99",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 1
