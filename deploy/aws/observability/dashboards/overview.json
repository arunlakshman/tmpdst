{
  "uid": "mani-overview",
  "title": "Manifester - Overview",
  "tags": [
    "manifester",
    "overview"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "utc",
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "graphTooltip": 1,
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Produce ack latency (seal to commit answer)",
      "description": "put + queue wait + commit. Excludes time batches sat in the open segment buffer (see segment open age); client-observed latency comes from the load generator.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le) (rate(manibroker_segment_seal_to_ack_seconds_bucket{run_id=\"$run_id\"}[$__rate_interval])))",
          "legendFormat": "p50",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(manibroker_segment_seal_to_ack_seconds_bucket{run_id=\"$run_id\"}[$__rate_interval])))",
          "legendFormat": "p99",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Segment open age (first batch to seal)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le) (rate(manibroker_segment_open_age_seconds_bucket{run_id=\"$run_id\"}[$__rate_interval])))",
          "legendFormat": "p50",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(manibroker_segment_open_age_seconds_bucket{run_id=\"$run_id\"}[$__rate_interval])))",
          "legendFormat": "p99",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Throughput: committed segment bytes/s",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(manibroker_segment_committed_bytes_total{run_id=\"$run_id\"}[$__rate_interval]))",
          "legendFormat": "committed (batch data + index)",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "refId": "A"
        },
        {
          "expr": "sum(rate(manibroker_segment_sealed_batch_bytes_total{run_id=\"$run_id\"}[$__rate_interval]))",
          "legendFormat": "sealed batch bytes",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Segments per second by seal reason",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (reason) (rate(manibroker_segments_sealed_total{run_id=\"$run_id\"}[$__rate_interval]))",
          "legendFormat": "{{reason}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "refId": "A"
        },
        {
          "expr": "sum(rate(manibroker_segments_failed_total{run_id=\"$run_id\"}[$__rate_interval]))",
          "legendFormat": "failed",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Segment size (mean committed bytes per segment)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(manibroker_segment_committed_bytes_total{run_id=\"$run_id\"}[$__rate_interval])) / sum(rate(manibroker_segments_committed_total{run_id=\"$run_id\"}[$__rate_interval]))",
          "legendFormat": "mean",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Buffered produce bytes (unacked)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "manibroker_buffered_bytes{run_id=\"$run_id\"}",
          "legendFormat": "buffered",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 7,
      "type": "logs",
      "title": "Logs: level >= warn",
      "description": "",
      "datasource": {
        "type": "loki",
        "uid": "${ds_loki}"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "expr": "{run_id=\"$run_id\", level=~\"warn|warning|error|fatal|dpanic|panic\"}",
          "legendFormat": "",
          "datasource": {
            "type": "loki",
            "uid": "${ds_loki}"
          },
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      }
    }
  ],
  "annotations": {
    "list": [
      {
        "name": "Run start/end",
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "iconColor": "blue",
        "target": {
          "type": "tags",
          "tags": [
            "manifester",
            "run:$run_id"
          ],
          "limit": 100
        }
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "ds_prom",
        "type": "datasource",
        "query": "prometheus",
        "label": "Prometheus",
        "current": {}
      },
      {
        "name": "ds_loki",
        "type": "datasource",
        "query": "loki",
        "label": "Loki",
        "current": {}
      },
      {
        "name": "run_id",
        "type": "query",
        "label": "run_id",
        "datasource": {
          "type": "prometheus",
          "uid": "${ds_prom}"
        },
        "query": {
          "query": "label_values(up, run_id)",
          "refId": "rid"
        },
        "refresh": 2,
        "sort": 2,
        "current": {}
      }
    ]
  }
}
