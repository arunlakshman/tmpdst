// Control-plane host add-on: this host's manicp. A log-store run has several CP hosts (rank 0 the preferred
// appender, ranks 1.. hot standbys, decision 51); each scrapes its own manicp and labels it cp_rank (and host).
// CloudWatch (DynamoDB table metrics) is in cpcloudwatch.alloy, installed on ONE CP host only so the
// DynamoDB series are not duplicated.
// Extra environment: CP_RANK (0 for the preferred appender).

discovery.relabel "cp_targets" {
	targets = [
		{"__address__" = "127.0.0.1:9101", "job" = "manicp", "service" = "manicp"},
	]

	rule {
		target_label = "host"
		replacement  = sys.env("HOST_NAME")
	}

	rule {
		target_label = "role"
		replacement  = sys.env("HOST_ROLE")
	}

	rule {
		target_label = "cp_rank"
		replacement  = sys.env("CP_RANK")
	}
}

prometheus.scrape "cp" {
	targets         = discovery.relabel.cp_targets.output
	forward_to      = [prometheus.remote_write.cloud.receiver]
	scrape_interval = "5s"
	scrape_timeout  = "4s"
}
